#!/bin/bash
#PBS -N msg_s4_select
#PBS -l select=1:ncpus=16:mem=64gb:scratch_local=20gb
#PBS -l walltime=4:00:00
#PBS -j oe
#
# Build hybrid mass-candidate sets (K=0,32,64) on the debug subset, from the
# prepped pools, and emit the fixed debug-subset ik2d list.
#   qsub scripts/v1.5_candidates/pbs/run_select_hybrid.pbs
set -euo pipefail
set +u; source /etc/profile || true; set -u

PLZEN=/storage/plzen1/home/jozefov_147
REPO=$PLZEN/projects/MassSpecGym_s4
ENV=$PLZEN/.conda/envs/massspecgym_s4
DATA=$REPO/_data/v1.5
RHC=$PLZEN/projects/retrieval_hacking_challenge/_data_gen
RESULTS=$REPO/_metacentrum_results
LOG=$RESULTS/select_${PBS_JOBID:-manual}.log
mkdir -p "$RESULTS" "$SCRATCHDIR/tmp"; export TMPDIR=$SCRATCHDIR/tmp
test "$(whoami)" = jozefov_147 || { echo wrong account; exit 10; }

cd "$REPO"
"$ENV/bin/python" scripts/v1.5_candidates/select_hybrid_candidates.py \
  --data-dir "$DATA" \
  --queries-parquet "$DATA/queries/massspecgym_query_molecules.parquet" \
  --mass-json "$RHC/MassSpecGym1.5_gen_retrieval_candidates_mass.json" \
  --ks 0,32,64 --top-n 300 \
  --out-dir "$DATA/analysis/hybrid_debug" 2>&1 | tee "$LOG"
echo "OK select_hybrid" | tee -a "$LOG"
cp "$LOG" "$RESULTS/" 2>/dev/null || true
